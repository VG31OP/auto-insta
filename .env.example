# Instagram Account & Creator Configuration
INSTAGRAM_HANDLE=your_creator_handle

# Browser & Automation Settings
BROWSER_PROFILE_DIR=.browser_profile
HEADLESS=true

# Neural Voiceover Synthesis (Edge-TTS)
# Options: en-US-ChristopherNeural, en-US-GuyNeural, en-US-AriaNeural, en-GB-RyanNeural
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+15%

# Default DM Funnel Keyword
DEFAULT_KEYWORD_CTA=TOOL
